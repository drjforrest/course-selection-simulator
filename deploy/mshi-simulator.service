[Unit]
Description=MSHI Course Selection Simulator
After=network.target

[Service]
Type=simple
User=mshi
WorkingDirectory=/opt/mshi-simulator
EnvironmentFile=/etc/mshi-simulator.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mshi-simulator/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
